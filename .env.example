# Copy to .env for local docker compose, or paste into EasyPanel → Environment

ENV=production
PORT=8080
SECRET_KEY=change-me-to-a-long-random-string

POSTGRES_DB=procplat
POSTGRES_USER=procplat
POSTGRES_PASSWORD=change-me-db-password

# Optional: restrict browser CORS (comma-separated). Leave empty for default.
# CORS_ORIGINS=https://your-domain.example

# Gunicorn workers (sync). Start low on small VPS plans.
WEB_CONCURRENCY=2

# EasyPanel → App → Deploy → Webhook URL (local deploy only; not needed on the server)
# EASYPANEL_DEPLOY_WEBHOOK=http://YOUR_HOST:3000/api/deploy/YOUR_TOKEN

